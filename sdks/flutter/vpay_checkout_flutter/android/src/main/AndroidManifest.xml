<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="dev.vpay.checkout_flutter">

  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <!--
      D5 (docs/plans/2026-09-13-flutter-plugin.md): a plain Activity, full-bleed
      WebView, non-negotiably `android:exported="false"`. This Activity takes a
      URL extra that carries a payer credential (the checkout session's own
      secret, in the URL fragment) — an exported Activity accepting that extra
      is a classic intent-redirection hole: any other app on the device could
      start it directly, handing it an attacker-chosen URL to load with the
      plugin's own WebView settings, or intercepting the extra by other means.
      No other app has any business starting this Activity, so it is launched
      only by this same app's own Flutter engine, with `startActivityForResult`.
    -->
    <activity
      android:name=".VpayCheckoutActivity"
      android:exported="false"
      android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
      android:configChanges="orientation|screenSize|keyboardHidden" />
  </application>

</manifest>
